<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/monitorContainer"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1.2"
    android:paddingTop="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sceneCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/sceneBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/crt_room_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDrawTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.06" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDrawBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.225" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDrawStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.18" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideDrawEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.82" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideScreenTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.312" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideScreenBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.645" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideScreenStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.239" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideScreenEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.761" />

        <FrameLayout
            android:id="@+id/drawingBoxContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_drawing_box_shell"
            android:elevation="16dp"
            android:padding="14dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/guideDrawBottom"
            app:layout_constraintEnd_toEndOf="@id/guideDrawEnd"
            app:layout_constraintStart_toStartOf="@id/guideDrawStart"
            app:layout_constraintTop_toTopOf="@id/guideDrawTop">

            <com.example.hackerclicker.InkCaptureView
                android:id="@+id/inkCaptureView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvDrawPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="monospace"
            android:shadowColor="#7A00FF41"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="DRAW EACH INDIVIDUAL GLYPH"
            android:textColor="#A8FF9D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/drawingBoxContainer"
            app:layout_constraintEnd_toEndOf="@id/drawingBoxContainer"
            app:layout_constraintStart_toStartOf="@id/drawingBoxContainer"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/monitorScreenFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="@id/guideScreenBottom"
            app:layout_constraintEnd_toEndOf="@id/guideScreenEnd"
            app:layout_constraintStart_toStartOf="@id/guideScreenStart"
            app:layout_constraintTop_toTopOf="@id/guideScreenTop">

            <com.example.hackerclicker.TerminalScreenView
                android:id="@+id/terminalScreenView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/monitorFlashOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="#A200FF6A" />

            <TextView
                android:id="@+id/tvTargetCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:shadowColor="#7A00FF41"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="#A8FF9D"
                android:textSize="30sp"
                android:textStyle="bold"
                android:visibility="invisible"
                tools:text="A9X4"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/rewardTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:shadowColor="#6639FF14"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4"
                android:textColor="#A4FF8E"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="+$90" />
        </FrameLayout>

        <TextView
            android:id="@+id/modelStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hud_chip_low_poly"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="#B7E6B8"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/monitorScreenFrame"
            app:layout_constraintTop_toTopOf="@id/guideScreenTop"
            tools:text="OCR READY" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
