<?xml version="1.0" encoding="utf-8"?>
<!-- // VISUAL -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- // VISUAL -->
    <item android:top="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#0D0D0D" />
        </shape>
    </item>

    <!-- // VISUAL -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:centerColor="#8B8B7A"
                android:endColor="#6E6E5F"
                android:startColor="#B0AD96" />
            <stroke
                android:width="1dp"
                android:color="#C6C1AB" />
        </shape>
    </item>

    <!-- // VISUAL -->
    <item
        android:bottom="20dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="#3A392D"
                android:startColor="#242319" />
        </shape>
    </item>
</layer-list>
