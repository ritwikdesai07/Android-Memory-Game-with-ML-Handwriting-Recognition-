<?xml version="1.0" encoding="utf-8"?>
<!-- // VISUAL -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- // VISUAL -->
    <item
        android:bottom="6dp"
        android:left="4dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp"
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp" />
            <gradient
                android:angle="0"
                android:endColor="#392A21"
                android:startColor="#7E5B46" />
        </shape>
    </item>

    <!-- // VISUAL -->
    <item
        android:left="30dp"
        android:right="2dp"
        android:top="10dp">
        <shape android:shape="oval">
            <size
                android:width="14dp"
                android:height="18dp" />
            <stroke
                android:width="3dp"
                android:color="#775544" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
