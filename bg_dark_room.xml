<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- DEBUG: base room darkness. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>

    <!-- DEBUG: central dim light source. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="50%"
                android:centerY="50%"
                android:endColor="#000000"
                android:gradientRadius="520dp"
                android:startColor="#1A2A1A"
                android:type="radial" />
        </shape>
    </item>

    <!-- DEBUG: vignette that darkens toward the room edges. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#00000000"
                android:centerX="50%"
                android:centerY="50%"
                android:endColor="#CC000000"
                android:gradientRadius="700dp"
                android:startColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
